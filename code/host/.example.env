APP_DEBUG = true

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = lin_hub
DB_USER = root
DB_PASS =
DB_PORT = 3306
DB_CHARSET = utf8mb4

DEFAULT_LANG = zh-cn

# ── 功能包管理路径配置（可留空回退默认值，相对路径基于 code/host 解析）──
# 安装位置（功能包源码落地根）
PACKAGE_LOAD_ROOT     = plugins
# 已安装状态记录文件（持久数据区 code/host/data）
PACKAGE_STATE_FILE    = data/plugin-state.json
# 可安装包下载/暂存根（临时物，可再下载）
PACKAGE_STAGING_ROOT  = package/staging
# 安装/升级备份根（持久数据）
PACKAGE_BACKUP_ROOT   = data/plugin-backups
# 禁用包隔离根（持久数据）
PACKAGE_DISABLED_ROOT = data/plugin-disabled
# 打包/目录包输出根（持久产物）
PACKAGE_PACKOUT_ROOT  = data/plugin-packout
# 功能包审核记录文件（持久数据）
PACKAGE_REVIEW_FILE   = data/plugin-review.json
# 功能包路由是否强制补齐 /admin/ 前缀（0=常规：包内自写 admin/ 前缀；1=强制补齐：平台统一补前缀，包内写裸路径；仅对 access=admin 的包补全，access=public 免登录公开包不补）
PACKAGE_ROUTE_FORCE_ADMIN = 0

# Redis Stream 事件总线（T6.3）；AUTH 留空表示无密码
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASS =

# UAIS 统一身份认证（T0.3）——请填实际值，.env 已被 .gitignore 忽略，勿提交真实凭证
UAIS_BASE_URL = https://uais.qianbiaodashuju.cn/
UAIS_APP_KEY =
UAIS_APP_SECRET =
UAIS_ADMIN_TAG = LinHub SuperAdministrator

# 以下是测试使用内容，正式环境可删除
UAIS_TEST_USER =
UAIS_TEST_PASS =

# ── 平台公共服务：附件托管（AT）──
ATTACH_DRIVER = local
# 本地驱动根目录；留空使用 code/host/data/attach（非 web 目录，统一下载入口）
ATTACH_BASE_DIR =
ATTACH_MAX_SIZE = 10M
# 允许的扩展名白名单，逗号分隔；留空表示不限
ATTACH_ALLOW_TYPES = jpg,jpeg,png,gif,webp,bmp,svg,pdf,zip,txt,json
# 默认可见性：private（私有，仅管理员与上传者）/ public（公开免鉴权）
ATTACH_DEFAULT_VISIBILITY = private
# 默认有效期天数：0=永不过期
ATTACH_DEFAULT_EXPIRE_DAYS = 0
# 图片缺失/删除/过期时是否返回默认图片（AT-8）
ATTACH_FALLBACK_IMAGE = 1
# 过期与孤儿清理：1=启用；cron 表达式仅用于记录与外部调度提示
ATTACH_CLEAN_ENABLED = 0
ATTACH_CLEAN_CRON =
# 七牛云驱动（密钥仅填环境变量，禁止写入源码；留空表示未配置）
ATTACH_QINIU_AK =
ATTACH_QINIU_SK =
ATTACH_QINIU_BUCKET =
ATTACH_QINIU_DOMAIN =
ATTACH_QINIU_PRIVATE = 0

# ── 平台公共服务：站内消息（IM）──
# 每个用户未读消息保留条数上限，超限自动把最旧未读置已读；0=不限
MSG_UNREAD_LIMIT = 0
# 消息保留天数；0=永久（当前版本仅记录配置，清理策略后续迭代）
MSG_RETENTION_DAYS = 0

# ── 平台 / workdesktop 版本检测与自升级 ──
# 平台（宿主 code/host）：自定义检测接口地址，返回标准 JSON（字段 version / download_url / release_note）；留空=不检测，仅显示当前版本
UPDATE_HOST_CHECK_URL =
# workdesktop 前端 UMD：只填包发布地址即可，平台自动向 npm registry 检测最新版本并取 tgz
# 直接填 npm 包页面地址，如 https://www.npmjs.com/package/workdesktop-ai；留空=默认官方包 workdesktop-ai
UPDATE_WORKDESKTOP_PACKAGE_URL = https://www.npmjs.com/package/workdesktop-ai

# =====================================================================
# LLM 网关（llmgateway 服务）
# =====================================================================
# 总开关：置 0 时所有 chat/embed 调用抛 LlmProviderException
LLM_GATEWAY_ENABLED = 1

# provider 配置（OpenAI 兼容协议）：按 provider 名大写注入一组键
# 多 provider 重复粘贴本块，换名字即可。示例三组常用 provider：
#
# OpenAI
LLM_PROVIDER_OPENAI_BASE_URL = https://api.openai.com/v1
LLM_PROVIDER_OPENAI_API_KEY =
# LLM_PROVIDER_OPENAI_TIMEOUT_CONNECT = 5
# LLM_PROVIDER_OPENAI_TIMEOUT_READ = 60
#
# DeepSeek
LLM_PROVIDER_DEEPSEEK_BASE_URL = https://api.deepseek.com/v1
LLM_PROVIDER_DEEPSEEK_API_KEY =
#
# 通义千问 / Kimi / 智谱 / 自建 vLLM 同理，前缀换成各自大写名即可
# 例如 LLM_PROVIDER_QWEN_BASE_URL=... 与 LLM_PROVIDER_QWEN_API_KEY=...
# 模型实例在后台 llmgateway 管理页录入（lg_mgt_llm_model），其中 provider 字段
# 对应这里的 provider 名（大小写不敏感，平台会转大写去查 env）。